---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { blogPosting, graph } from '../../lib/schema';
import { formatDate, publishedPosts, readingMinutes, TEAM } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const image = post.data.ogImage;
const path = `/blog/${post.id}/`;
---

<Base
  title={post.data.metaTitle}
  description={post.data.description}
  image={image}
  ogType="article"
  published={post.data.date.toISOString()}
  jsonLd={graph(blogPosting({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    path,
    image,
  }))}
>
  <main id="main" class="article">
    <article class="article-inner">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="meta">{formatDate(post.data.date)} · {readingMinutes(post.body)} min read · {TEAM}</p>
      <figure class="figure">
        <img src={image} alt="" width="1200" height="630" />
      </figure>
      <div class="prose">
        <Content />
      </div>
      <p class="article-next">Have a product to take into production? <a href="/#contact">Send a project brief</a>. We reply within one business day.</p>
    </article>
  </main>
</Base>

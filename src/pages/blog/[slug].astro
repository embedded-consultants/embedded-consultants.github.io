---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { blogPosting, breadcrumb, faqPage, graph } from '../../lib/schema';
import { absolute } from '../../config';
import { formatDate, modifiedDate, publishedPosts, readingMinutes, TEAM } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const image = post.data.ogImage;
const path = `/blog/${post.id}/`;
const modified = modifiedDate(post);
---

<Base
  title={post.data.metaTitle}
  description={post.data.description}
  image={image}
  ogType="article"
  published={post.data.date.toISOString()}
  modified={modified.toISOString()}
  jsonLd={graph(
    blogPosting({
      title: post.data.title,
      description: post.data.description,
      date: post.data.date,
      modified,
      path,
      image,
    }),
    faqPage(post.data.faq, `${absolute(path)}#faq`),
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: post.data.title, path },
    ]),
  )}
>
  <main id="main" class="article">
    <article class="article-inner">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="meta">{formatDate(post.data.date)} · {readingMinutes(post.body)} min read · {TEAM}</p>
      <p class="definition">{post.data.definition}</p>
      <aside class="takeaways">
        <h2>Key takeaways</h2>
        <ul>
          {post.data.takeaways.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
      <figure class="figure">
        <img src={image} alt="" width="1200" height="630" />
      </figure>
      <div class="prose">
        <Content />
      </div>
      <section class="post-faq" id="faq" aria-labelledby="post-faq-heading">
        <h2 id="post-faq-heading">Questions and answers</h2>
        {post.data.faq.map((item) => (
          <div>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </section>
      <p class="article-next">Have a product to take into production? <a href="/#contact">Send a project brief</a>. We reply within one business day.</p>
    </article>
  </main>
</Base>

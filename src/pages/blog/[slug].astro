---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import is32 from '../../assets/blog/is32.webp';
import tcke from '../../assets/blog/tcke.webp';
import { blogPosting, graph } from '../../lib/schema';
import { formatDate, readingMinutes } from '../../lib/posts';

const figures: Record<string, { src: ImageMetadata; alt: string }> = {
  is32fl3202_review: {
    src: is32,
    alt: 'Diagram of the IS32FL3202 LED controller: CAN-bus RGB drive, 12-bit PWM, AEC-Q100, and the WFDFN-10 package.',
  },
  tcke9_review: {
    src: tcke,
    alt: 'Diagram of the TCKE9 eFuse: 23 volt 4 amp protection, adjustable overcurrent limit, and the WSON8 package.',
  },
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const figure = figures[post.id];
const image = `/og/og-${post.id}.png`;
const path = `/blog/${post.id}/`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={image}
  ogType="article"
  published={post.data.date.toISOString()}
  jsonLd={graph(blogPosting({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    path,
    image,
  }))}
>
  <main id="main" class="article">
    <article class="article-inner">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="meta">{formatDate(post.data.date)} · {readingMinutes(post.body)} min read · Embedded Consultants, Novi Sad</p>
      {figure && (
        <figure class="figure">
          <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280]} sizes="(min-width: 760px) 720px, 100vw" />
        </figure>
      )}
      <div class="prose">
        <Content />
      </div>
      <p class="article-next">Planning a board? <a href="/#contact">Tell us about the product</a>. We reply within one business day.</p>
    </article>
  </main>
</Base>

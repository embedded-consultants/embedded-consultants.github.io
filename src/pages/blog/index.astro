---
import Redirect from '../../components/Redirect.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, publishedPosts, readingMinutes } from '../../lib/posts';

const posts = await publishedPosts();
const description = 'Engineering notes on hardware, firmware and taking an electronics product to production.';
---

{posts.length === 0 ? (
  <Redirect to="/" />
) : (
<Base title="Engineering notes" description={description} image="/og/og-blog.png">
  <main id="main" class="page">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>Engineering notes from real projects.</h1>
      <p class="lead">Hardware, firmware and the path from a working prototype to production.</p>
      <div class="page-list">
        {posts.map((post) => (
          <a class="post" href={`/blog/${post.id}/`}>
            <img src={post.data.ogImage} alt="" width="1200" height="630" />
            <span class="copy">
              <span class="cat">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="rd">{formatDate(post.data.date)} · {readingMinutes(post.body)} min read</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>
)}

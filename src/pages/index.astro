---
import Base from '../layouts/Base.astro';
import lyra from '../assets/partners/lyra.webp';
import pcbdesign from '../assets/partners/pcbdesign.webp';
import sensa from '../assets/partners/sensa.webp';
import kingpin from '../assets/partners/kingpin.webp';
import valsogard from '../assets/partners/valsogard.webp';
import ContactFlow from '../components/ContactFlow.astro';
import { site } from '../config';
import { faq, projects, services, steps } from '../data/home';
import { breadcrumb, faqPage, graph, serviceList, webPage } from '../lib/schema';
import { formatDate, publishedPosts, readingMinutes } from '../lib/posts';

const posts = (await publishedPosts()).slice(0, 3);
const logos = [
  { src: lyra, alt: 'Lyra', sq: false },
  { src: pcbdesign, alt: 'PCB Design', sq: false },
  { src: sensa, alt: 'Sensa', sq: false },
  { src: kingpin, alt: 'Kingpin', sq: true },
  { src: valsogard, alt: 'Valsogard', sq: true },
];
---

<Base title={site.title} description={site.description} jsonLd={graph(webPage(), faqPage(faq), breadcrumb([{ name: 'Home', path: '/' }]), ...serviceList())}>
  <main id="main">
    <section class="hero dark" id="top">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="wrap">
        <p class="eyebrow">Electronics product development</p>
        <h1>Electronics product development.</h1>
        <p class="line">PCB design services, firmware, and production.</p>
        <a class="btn btn-primary" href="#contact" data-umami-event="Start a project">Start a project</a>
      </div>
    </section>

    <section id="contact" class="contact dark">
      <div class="wrap">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Tell us about the product.</h2>
          <p class="lead">A short brief is enough. We reply within one business day.</p>
        </div>
        <div id="contact-call">
          <ContactFlow />
        </div>
      </div>
    </section>

    <section class="proof" aria-label="Clients and partners">
      <div class="wrap">
        <p>Partners</p>
        <ul class="logos">
          {logos.map((logo) => (
            <li>
              <img
                class={logo.sq ? 'sq' : undefined}
                src={logo.src.src}
                width={logo.src.width}
                height={logo.src.height}
                alt={logo.alt}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
          <li><span class="word">ProSys</span></li>
          <li><span class="word">AISLER</span></li>
        </ul>
      </div>
    </section>

    <section id="services">
      <div class="wrap">
        <p class="eyebrow">Services</p>
        <h2>PCB design and the rest of the product.</h2>
        <div class="cards4">
          {services.map((service) => (
            <article class="card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="process">
      <div class="wrap">
        <p class="eyebrow">How we work</p>
        <h2>Four steps.</h2>
        <ol class="steps steps-4">
          {steps.map((step) => (
            <li class="step">
              <div class="n">{step.n}</div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="work">
      <div class="wrap">
        <p class="eyebrow">Products</p>
        <h2>Products we have built.</h2>
        <div class="work-grid">
          {projects.map((project) => (
            <article class="proj">
              <div class="vis">
                {'image' in project && project.image ? (
                  <img src={project.image} alt="" width="640" height="480" />
                ) : (
                  <Fragment set:html={'art' in project ? project.art : ''} />
                )}
              </div>
              <div class="body">
                <span class="kicker">{project.kicker}</span>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {posts.length > 0 && (
      <section id="blog" class="blog">
        <div class="wrap">
          <div class="blog-top">
            <div>
              <p class="eyebrow">From the blog</p>
              <h2>Engineering notes from real projects.</h2>
            </div>
            <a class="more" href="/blog/">All articles</a>
          </div>
          <div class="posts">
            {posts.map((post) => (
              <a class="post" href={`/blog/${post.id}/`}>
                <span class="cat">{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="rd">{formatDate(post.data.date)} · {readingMinutes(post.body)} min read</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="faq" id="faq" aria-labelledby="faq-heading">
      <div class="wrap">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-heading">Questions we hear before most projects.</h2>
        </div>
        <div>
          {faq.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>
</Base>

---
import Base from '../layouts/Base.astro';
import lyra from '../assets/partners/lyra.webp';
import pcbdesign from '../assets/partners/pcbdesign.webp';
import sensa from '../assets/partners/sensa.webp';
import kingpin from '../assets/partners/kingpin.webp';
import valsogard from '../assets/partners/valsogard.webp';
import prosys from '../assets/partners/prosys.webp';
import aisler from '../assets/partners/aisler.webp';
import ContactFlow from '../components/ContactFlow.astro';
import { site } from '../config';
import { faq, projects, services, steps } from '../data/home';
import { breadcrumb, faqPage, graph, serviceList, webPage } from '../lib/schema';
import { formatDate, publishedPosts, readingMinutes } from '../lib/posts';

const posts = (await publishedPosts()).slice(0, 3);
const logos = [
  { src: lyra, alt: 'Lyra', sq: false },
  { src: pcbdesign, alt: 'PCB Design', sq: false },
  { src: sensa, alt: 'Sensa', sq: false },
  { src: kingpin, alt: 'Kingpin', sq: true },
  { src: valsogard, alt: 'Valsogard', sq: true },
  { src: prosys, alt: 'ProSys', sq: true },
  { src: aisler, alt: 'AISLER', sq: false },
];
---

<Base title={site.title} description={site.description} jsonLd={graph(webPage(), faqPage(faq), breadcrumb([{ name: 'Home', path: '/' }]), ...serviceList())}>
  <main id="main">
    <section class="hero dark" id="top">
      <div class="grid-bg" aria-hidden="true"></div>
      <svg class="hero-board" viewBox="0 0 640 480" aria-hidden="true">
        <rect x="70" y="36" width="500" height="408" rx="18" fill="none" stroke="#2A303A" stroke-width="1.5" />
        <circle cx="96" cy="62" r="5" fill="none" stroke="#2A303A" />
        <circle cx="544" cy="62" r="5" fill="none" stroke="#2A303A" />
        <circle cx="96" cy="418" r="5" fill="none" stroke="#2A303A" />
        <circle cx="544" cy="418" r="5" fill="none" stroke="#2A303A" />
        <path class="quiet" d="M120 150h90v70h70" />
        <path class="quiet" d="M120 330h140v-60" />
        <path class="quiet" d="M430 190h90v80h-40" />
        <path class="live" d="M140 210h120v40h90" />
        <path class="live slow" d="M390 280h70v90H300" />
        <rect x="250" y="150" width="170" height="140" rx="12" fill="#161A21" stroke="#D9702B" stroke-width="1.6" />
        <rect x="274" y="174" width="122" height="92" rx="6" fill="none" stroke="#D9702B" opacity="0.45" />
        <g fill="#D9702B">
          <circle class="dot" r="3.5" />
          <circle class="dot second" r="3.5" />
        </g>
      </svg>
      <div class="wrap">
        <p class="eyebrow">Electronics product development</p>
        <h1>Electronics product development.</h1>
        <p class="line">PCB design services, firmware, and production.</p>
        <a class="btn btn-primary" href="#contact" data-umami-event="Start a project">Start a project</a>
      </div>
    </section>

    <section class="proof" aria-label="Clients and partners">
      <div class="wrap">
        <p>Partners</p>
        <ul class="logos">
          {logos.map((logo) => (
            <li>
              <img
                class={logo.sq ? 'sq' : undefined}
                src={logo.src.src}
                width={logo.src.width}
                height={logo.src.height}
                alt={logo.alt}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="services">
      <div class="wrap">
        <p class="eyebrow">Services</p>
        <h2>PCB design and the rest of the product.</h2>
        <div class="cards4">
          {services.map((service) => (
            <article class="card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="process">
      <div class="wrap">
        <p class="eyebrow">How we work</p>
        <h2>From idea to production.</h2>
        <p class="lead">Eight steps. A gate before the next one starts.</p>
        <ol class="steps">
          {steps.map((step) => (
            <li class:list={['step', { gate: step.gate }]}>
              {step.gate && <span class="gate-pill">Gate</span>}
              <div class="n">{step.n}</div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="work">
      <div class="wrap">
        <p class="eyebrow">Products</p>
        <h2>Products we have built.</h2>
        <div class="work-grid">
          {projects.map((project) => (
            <article class="proj">
              <div class="vis" set:html={project.art} />
              <div class="body">
                <span class="kicker">{project.kicker}</span>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {posts.length > 0 && (
      <section id="blog" class="blog">
        <div class="wrap">
          <div class="blog-top">
            <div>
              <p class="eyebrow">From the blog</p>
              <h2>Engineering notes from real projects.</h2>
            </div>
            <a class="more" href="/blog/">All articles</a>
          </div>
          <div class="posts">
            {posts.map((post) => (
              <a class="post" href={`/blog/${post.id}/`}>
                <span class="cat">{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="rd">{formatDate(post.data.date)} · {readingMinutes(post.body)} min read</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="faq" id="faq" aria-labelledby="faq-heading">
      <div class="wrap">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-heading">Questions we hear before most projects.</h2>
        </div>
        <div>
          {faq.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="contact dark">
      <div class="wrap">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Tell us about the product.</h2>
          <p class="lead">A short brief is enough. We reply within one business day.</p>
          <ul class="reach">
            <li>
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9v10M6 5h.01M10 19v-6a4 4 0 0 1 8 0v6M10 11v8" /></svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a href={site.x} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
                X
              </a>
            </li>
            <li>
              <a href={`mailto:${site.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M4 7l8 6 8-6" /></svg>
                Email
              </a>
            </li>
          </ul>
        </div>
        <div id="contact-call">
          <ContactFlow />
        </div>
      </div>
    </section>

  </main>
</Base>

---
import Base from '../layouts/Base.astro';
import ContactFlow from '../components/ContactFlow.astro';
import Partners from '../components/Partners.astro';
import { site } from '../config';
import { faq, projects, services, steps } from '../data/home';
import { breadcrumb, faqPage, graph, serviceList, webPage } from '../lib/schema';
import { formatDate, publishedPosts, readingMinutes } from '../lib/posts';

const posts = await publishedPosts();
const featured = posts[0];
const notes = posts.slice(1, 5);
const selected = projects.slice(0, 4);
const icons = [
  '<rect x="14" y="14" width="28" height="28"/><path d="M20 14V6M28 14V6M36 14V6M20 42v8M28 42v8M36 42v8M14 20H6M14 28H6M14 36H6M42 20h8M42 28h8M42 36h8"/><circle cx="28" cy="28" r="5" stroke="#E0843A"/>',
  '<path d="M18 18L6 28l12 10M38 18l12 10-12 10"/><path d="M32 12L24 44" stroke="#E0843A"/>',
  '<rect x="6" y="10" width="44" height="30" rx="2"/><path d="M20 48h16M28 40v8"/><path d="M16 22l6 6-6 6M26 34h10" stroke="#E0843A"/>',
  '<path d="M28 6l20 11v22L28 50 8 39V17z"/><path d="M8 17l20 11 20-11M28 28v22" stroke="#E0843A"/>',
];
const industries = [
  { title: 'Industrial', text: 'Controllers, sensing and gateways built for long life and harsh environments.' },
  { title: 'Consumer', text: 'Connected, battery-powered devices tuned for cost, size and the person using them.' },
  { title: 'Automotive', text: 'Vehicle electronics, gateways and test equipment for the electrical environment of a car.' },
  { title: 'Medical', text: 'Precise electronics developed with traceability and regulated-product practice in mind.' },
];
---

<Base title={site.title} description={site.description} jsonLd={graph(webPage(), faqPage(faq), breadcrumb([{ name: 'Home', path: '/' }]), ...serviceList())}>
  <main id="main">
    <header class="c-hero">
      <svg class="circ" viewBox="0 0 900 900" fill="none" aria-hidden="true">
        <circle class="ring" cx="450" cy="450" r="430" stroke="#E0843A" stroke-width="2" />
        <circle cx="450" cy="450" r="330" fill="#E0843A" opacity=".1" />
        <g stroke="#E0843A" stroke-width="2" opacity=".55">
          <path d="M120 450H300L360 390H520L580 450H780" />
          <path d="M180 330H320L380 270H640" />
          <path d="M200 590H400L450 640H700" />
        </g>
        <rect x="620" y="150" width="150" height="130" rx="6" fill="#161C24" stroke="#E0843A" stroke-width="2" />
        <circle cx="695" cy="215" r="18" fill="#E0843A" />
      </svg>
      <div class="w">
        <div data-reveal>
          <p class="eyebrow">Electronics product development</p>
          <h1>Electronics product development, to <b>mass production.</b></h1>
          <p class="lead">{site.description}</p>
          <div class="hcta">
            <a class="btn btn-primary" href="#contact">Start a project</a>
            <a class="btn-line" href="#services">Explore our services</a>
          </div>
        </div>
        {featured && (
          <a class="feat" href={`/blog/${featured.id}/`} data-reveal>
            <small>Engineering note</small>
            <h2>{featured.data.title}</h2>
            <span>Read the article →</span>
          </a>
        )}
      </div>
    </header>

    <div class="stats">
      <div class="w">
        <div class="s"><b data-count="10" data-suffix="+">10+</b><span>years of experience</span></div>
        <div class="s"><b data-count="50" data-suffix="+">50+</b><span>projects completed</span></div>
        <div class="s"><b data-count="10">10</b><span>countries</span></div>
      </div>
    </div>

    <Partners />

    <section class="c-sec" id="services">
      <div class="w">
        <div class="sh" data-reveal>
          <h2>What we <b>do</b></h2>
          <p>Four disciplines under one roof, so the electronics, the code and the enclosure are designed together.</p>
        </div>
        <div class="svc">
          {services.map((service, i) => (
            <article data-reveal>
              <span class="no">0{i + 1}</span>
              <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#0E1116" stroke-width="2" aria-hidden="true" set:html={icons[i]} />
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <a class="more" href="/services/">Learn more</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c-sec ind" id="industries">
      <div class="w">
        <div class="sh" data-reveal>
          <h2>Industries we <b>build for</b></h2>
          <p>Products that have to work on a factory floor, in a vehicle, in a clinic, or in someone’s hand.</p>
        </div>
        <div class="indg">
          {industries.map((item) => (
            <article class="ic" data-reveal>
              <svg class="bg" viewBox="0 0 300 380" fill="none" stroke="#E0843A" opacity=".35" aria-hidden="true">
                <path d="M30 70h120M30 110h80M30 150h140" />
                <circle cx="220" cy="120" r="36" />
              </svg>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c-sec" id="process">
      <div class="w">
        <div class="sh" data-reveal>
          <h2>How we <b>work</b></h2>
          <p>Eight steps from the brief to production files, with a gate before the next one starts.</p>
        </div>
        <div class="how-line">
          {steps.map((step) => (
            <article class="step" data-reveal>
              <div class="dot">{step.n}</div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c-sec workband" id="work">
      <div class="w">
        <div class="sh" data-reveal>
          <h2>Selected <b>work</b></h2>
          <a class="more" href="/portfolio/">View all projects</a>
        </div>
        <div class="cards4w">
          {selected.map((project) => (
            <article class="pcard" data-reveal>
              <div class="vis" set:html={project.art} />
              <div class="b">
                <span class="tag">{project.kicker}</span>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="c-sec" id="blog">
        <div class="w">
          <div class="sh" data-reveal>
            <h2>Engineering <b>notes</b></h2>
            <a class="more" href="/blog/">All insights</a>
          </div>
          <div class="ins">
            {featured && (
              <a class="big" href={`/blog/${featured.id}/`} data-reveal>
                <span class="tag">{featured.data.category}</span>
                <h3>{featured.data.title}</h3>
                <span class="more">Read the article</span>
              </a>
            )}
            {notes.map((post) => (
              <a class="note-card" href={`/blog/${post.id}/`} data-reveal>
                <span class="tag">{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="m">{formatDate(post.data.date)} · {readingMinutes(post.body)} min</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="c-sec" id="faq">
      <div class="w faq-grid">
        <div data-reveal>
          <p class="eyebrow">FAQ</p>
          <h2>Questions we hear before most projects.</h2>
        </div>
        <div data-reveal>
          {faq.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="w">
        <h2>Let’s build your <b>next product.</b></h2>
        <div>
          <p>Tell us what you are making. A short brief is enough. We reply within one business day.</p>
          <a class="btn btn-primary" href="#contact" style="background:#000;color:#fff">Start a project</a>
          <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </section>

    <section id="contact" class="contact dark">
      <div class="w">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Tell us about the product.</h2>
          <p class="lead">A short brief is enough. We reply within one business day.</p>
        </div>
        <ContactFlow />
      </div>
    </section>
  </main>
</Base>

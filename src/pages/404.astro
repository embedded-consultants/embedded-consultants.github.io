---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That page is not on the Embedded Consultants site."
  noindex={true}
  omitCanonical={true}
>
  <main id="main" class="missing">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page is not here.</h1>
      <p class="lead">The link may be from an older version of the site. The notes and the contact form are still up.</p>
      <a class="btn btn-primary" href="/">Back to the home page</a>
    </div>
  </main>
</Base>

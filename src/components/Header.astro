---
import Logo from './Logo.astro';
import { publishedPosts } from '../lib/posts';

const onHome = Astro.url.pathname === '/';
const to = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);
const showBlog = (await publishedPosts()).length > 0;
---

<header>
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="Embedded Consultants home">
      <Logo alt="Embedded Consultants" />
    </a>
    <ul class="nav-links" id="site-nav" data-nav-panel>
      <li><a href={to('services')}>What we do</a></li>
      <li><a href={to('industries')}>Industries</a></li>
      <li><a href="/portfolio/">Our work</a></li>
      {showBlog && <li><a href="/blog/">Insights</a></li>}
      <li><a href="/contact/">Contact</a></li>
      <li class="mobile-only"><a class="btn btn-primary" href="/contact/">Contact us</a></li>
    </ul>
    <a class="btn btn-primary nav-cta" href="/contact/" data-umami-event="Contact us">Contact us</a>
    <button class="burger" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span></span>
    </button>
  </div>
</header>
<noscript>
  <style>
    @media (max-width: 1000px) {
      .burger { display: none !important; }
      .nav-links { display: flex !important; }
    }
  </style>
</noscript>
